{
  "name": "flowso",
  "version": "0.1.0",
  "description": "Local WhatsApp Flows simulator: Flow JSON runtime, validator, Meta-compatible endpoint client and Vue renderer",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime.js"
    },
    "./validator": {
      "types": "./dist/validator/index.d.ts",
      "import": "./dist/validator.js"
    },
    "./endpoint": {
      "types": "./dist/endpoint/index.d.ts",
      "import": "./dist/endpoint.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue.js"
    },
    "./vue/theme.css": "./dist/vue/theme.css",
    "./package.json": "./package.json",
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "skills",
    "templates",
    "scripts/postinstall.cjs"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "playground": "vite --config playground/vite.config.ts",
    "build:playground": "vite build --config playground/vite.config.ts",
    "typecheck:vue": "vue-tsc --noEmit -p tsconfig.json",
    "build": "bun run build:lib && bun run build:types && bun run build:playground",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
    "cli": "bun src/cli/main.ts",
    "prepublishOnly": "bun run release:check",
    "test:package": "node scripts/smoke-package.mjs",
    "postinstall": "node scripts/postinstall.cjs",
    "release:check": "bun run typecheck && bun run typecheck:vue && bun run test && bun run test:package"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@lezer/highlight": "1.2.3",
    "@types/node": "22.20.2",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.5.0",
    "codemirror": "6.0.2",
    "happy-dom": "17.6.3",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "vue": "3.5.42",
    "vue-tsc": "2.2.12"
  },
  "bin": {
    "flowso": "dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokapso/flowso.git"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-flows",
    "flow-json",
    "simulator",
    "meta"
  ],
  "dependencies": {
    "@kapso/whatsapp-cloud-api": "0.3.0"
  }
}
