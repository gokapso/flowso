# Copy to .env.local and fill values locally. Do not commit .env.local.
# Leave CAL_API_BASE_URL unset to use the fixture.
# Uncomment the URL to use Cal.com; bookings remain disabled until explicitly enabled.
# CAL_API_BASE_URL=https://api.cal.com/v2
CAL_API_KEY=
CAL_EVENT_TYPE_ID=123
CAL_TIME_ZONE=UTC
CAL_ALLOW_BOOKINGS=0
PORT=4312
